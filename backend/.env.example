SECRET_KEY=your-django-secret
DEBUG=True
DATABASE_URL=postgresql://...

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Same string in GitHub repo → Settings → Webhooks → Secret (you generate this yourself).
GITHUB_WEBHOOK_SECRET=your-long-random-secret

# Public backend URL (no trailing slash) — auto-registers webhooks on repo connect.
# Local: http://127.0.0.1:8000
# Production: https://commitiq-etsu.onrender.com
PUBLIC_API_URL=http://127.0.0.1:8000

# Comma-separated. Production example:
# ALLOWED_HOSTS=commitiq-api.onrender.com,.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev,.ngrok-free.app,.ngrok.io

# Production: your Render HTTPS URL + Vercel frontend if using Django admin
# CSRF_TRUSTED_ORIGINS=https://commitiq-api.onrender.com,https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production: your Vercel URL (comma-separated if multiple)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Celery task queue (local dev without Docker: redis-server on localhost:6379)
# Docker Compose sets redis://redis:6379/0 via compose environment (must not override in container).
# When using docker compose, leave these as localhost here OR omit — compose env wins if override=False.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
