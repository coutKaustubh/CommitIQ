SECRET_KEY=your-django-secret
DEBUG=True
DATABASE_URL=postgresql://...

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Same string in GitHub repo → Settings → Webhooks → Secret (you generate this yourself).
GITHUB_WEBHOOK_SECRET=your-long-random-secret

# YOU set this in settings.py from .env — include .ngrok-free.dev for local ngrok tests.
# ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev,.ngrok-free.app,.ngrok.io

# Full https URL for Django admin login over ngrok (CSRF Origin check).
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://YOUR-SUBDOMAIN.ngrok-free.dev
